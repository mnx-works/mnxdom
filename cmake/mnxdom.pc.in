prefix=@CMAKE_INSTALL_PREFIX@
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: mnxdom
Description: MNX Document Object Model for C++20
Version: @PROJECT_VERSION@
Requires: nlohmann_json
Libs: -L${libdir} -lmnxdom@MNXDOM_PC_VALIDATOR_LIBS@
@MNXDOM_PC_VALIDATOR@
Cflags: -I${includedir} -DJSON_DISABLE_ENUM_SERIALIZATION=1
